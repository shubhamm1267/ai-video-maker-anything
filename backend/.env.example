# ---------- AI providers ----------
AGNES_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here

# ---------- Server ----------
PORT=3000

# Video job kitni der tak wait kare (minutes)
JOB_TIMEOUT_MINUTES=15
POLL_INTERVAL_MS=5000

# ---------- Image -> Video relay ----------
# Agnes ka server image ko khud download karta hai, isliye image ka
# PUBLIC URL chahiye. Default me app free hosts (catbox / 0x0 / tmpfiles)
# use karta hai. Ye kabhi kabhi block ho jaate hain, isliye:
#
# 1) Sabse reliable (free): imgbb key - https://api.imgbb.com/
IMGBB_API_KEY=

# 2) Ya apna hi server public karein (ngrok / cloudflared) aur yahan
#    public URL daalein. Tab image is server se hi serve hogi:
#    PUBLIC_BASE_URL=https://abcd-12-34.ngrok-free.app
PUBLIC_BASE_URL=

# ---------- Watermark (optional, ffmpeg post-processing) ----------
CHANNEL_WATERMARK=MarbleVortex3D
WATERMARK_OPACITY=0.72
